{
  "info": {
    "_postman_id": "6fc0f59e-1181-4e10-80d5-1d0f8a3d1c99",
    "name": "Rengy Mini CRM API",
    "description": "Postman collection for the Rengy MERN Mini CRM backend. The API uses HTTP-only cookies for authentication, so keep Postman cookies enabled. Login sets accessToken and refreshToken cookies automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "serverUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "renderBaseUrl",
      "value": "https://rengy-backend-nrla.onrender.com/api",
      "type": "string"
    },
    {
      "key": "name",
      "value": "Rengy Test User",
      "type": "string"
    },
    {
      "key": "email",
      "value": "rengy.test@example.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "StrongPass123",
      "type": "string"
    },
    {
      "key": "otp",
      "value": "123456",
      "type": "string"
    },
    {
      "key": "contactId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Server Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{serverUrl}}",
              "host": ["{{serverUrl}}"]
            },
            "description": "Checks the backend server root endpoint."
          },
          "response": []
        },
        {
          "name": "API Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            },
            "description": "Checks the main API router."
          },
          "response": []
        },
        {
          "name": "Auth Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": ["{{baseUrl}}"],
              "path": ["auth"]
            },
            "description": "Checks the auth router."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "description": "Run Register, then use the OTP received by email in Verify Account, then Login. Postman will store auth cookies after Login.",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Creates an unverified user and sends a verification OTP email through Brevo SMTP."
          },
          "response": []
        },
        {
          "name": "Verify Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/isverify",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "isverify"]
            },
            "description": "Verifies a newly registered user using the OTP received by email."
          },
          "response": []
        },
        {
          "name": "Sign In",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Logs in a verified user. This route has login rate limiting: 3 account attempts per 10 minutes."
          },
          "response": []
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh-token"]
            },
            "description": "Uses the refreshToken HTTP-only cookie to issue a new accessToken cookie."
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "forgot-password"]
            },
            "description": "Sends a reset-password OTP if the email exists."
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\",\n  \"newPassword\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "reset-password"]
            },
            "description": "Resets password using the reset OTP received by email."
          },
          "response": []
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"newPassword\": \"StrongPass1234\",\n  \"confirmPassword\": \"StrongPass1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "change-password"]
            },
            "description": "Protected route. Changes the logged-in user's password and clears auth cookies."
          },
          "response": []
        },
        {
          "name": "Auth Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Protected route. Returns the user payload decoded from the access token."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "description": "Protected route. Clears access and refresh cookies."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Profile",
      "description": "Profile routes require login cookies from the Sign In request.",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            },
            "description": "Protected route. Returns logged-in user profile."
          },
          "response": []
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rengy Updated User\",\n  \"email\": \"{{email}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/update",
              "host": ["{{baseUrl}}"],
              "path": ["users", "update"]
            },
            "description": "Protected route. Updates name and/or email."
          },
          "response": []
        },
        {
          "name": "Delete Account",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/delete",
              "host": ["{{baseUrl}}"],
              "path": ["users", "delete"]
            },
            "description": "Protected route. Deletes the logged-in user, contacts, activity logs, and clears cookies."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Contacts",
      "description": "Contact routes require login cookies from the Sign In request.",
      "item": [
        {
          "name": "List Contacts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contacts?page=1&limit=10&search=&status=all",
              "host": ["{{baseUrl}}"],
              "path": ["contacts"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "search",
                  "value": ""
                },
                {
                  "key": "status",
                  "value": "all",
                  "description": "Use all, Lead, Prospect, or Customer."
                }
              ]
            },
            "description": "Protected route. Returns contacts with pagination, search, status filter, and status counts."
          },
          "response": []
        },
        {
          "name": "Export Contacts CSV",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contacts/export/csv?search=&status=all",
              "host": ["{{baseUrl}}"],
              "path": ["contacts", "export", "csv"],
              "query": [
                {
                  "key": "search",
                  "value": ""
                },
                {
                  "key": "status",
                  "value": "all",
                  "description": "Use all, Lead, Prospect, or Customer."
                }
              ]
            },
            "description": "Protected route. Downloads a CSV file containing all matching contacts for the logged-in user, including user id and contact details."
          },
          "response": []
        },
        {
          "name": "Create Contact",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const contact = json.data;",
                  "if (contact && contact._id) {",
                  "  pm.collectionVariables.set('contactId', contact._id);",
                  "}",
                  "pm.test('Contact created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha Rao\",\n  \"email\": \"asha.rao@example.com\",\n  \"phone\": \"+91 98765 43210\",\n  \"company\": \"Jaimax Technologies\",\n  \"status\": \"Lead\",\n  \"notes\": \"Interested in CRM workflow automation.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/contacts",
              "host": ["{{baseUrl}}"],
              "path": ["contacts"]
            },
            "description": "Protected route. Creates a contact and writes a created activity log."
          },
          "response": []
        },
        {
          "name": "Edit Contact",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha Rao\",\n  \"email\": \"asha.rao@example.com\",\n  \"phone\": \"+91 98765 43211\",\n  \"company\": \"Jaimax Technologies\",\n  \"status\": \"Prospect\",\n  \"notes\": \"Moved from Lead to Prospect after demo call.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/contacts/{{contactId}}",
              "host": ["{{baseUrl}}"],
              "path": ["contacts", "{{contactId}}"]
            },
            "description": "Protected route. Updates contact fields and writes an activity log containing before/after changes. If no content changes, API returns 'No content changed'."
          },
          "response": []
        },
        {
          "name": "Delete Contact",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contacts/{{contactId}}",
              "host": ["{{baseUrl}}"],
              "path": ["contacts", "{{contactId}}"]
            },
            "description": "Protected route. Deletes a contact and writes a deleted activity log."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Activity Logs",
      "description": "Activity routes require login cookies from the Sign In request.",
      "item": [
        {
          "name": "List All Activity Logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/activity-logs?page=1&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["activity-logs"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5",
                  "description": "Backend caps activity logs at 5 per page."
                }
              ]
            },
            "description": "Protected route. Returns all activity logs for the logged-in user."
          },
          "response": []
        },
        {
          "name": "List Contact Activity Logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/activity-logs/contacts/{{contactId}}?page=1&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["activity-logs", "contacts", "{{contactId}}"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5",
                  "description": "Backend caps activity logs at 5 per page."
                }
              ]
            },
            "description": "Protected route. Returns activity logs for one contact, including add/edit/delete events and change details."
          },
          "response": []
        }
      ]
    }
  ]
}
